---
import BaseLayout from './BaseLayout.astro'
import FormattedDate from '../components/FormattedDate.astro'
import TagList from '../components/TagList.astro'
import Giscus from '../components/Giscus.astro'
import type { CollectionEntry } from 'astro:content'
import 'katex/dist/katex.min.css'

interface Props {
  entry: CollectionEntry<'posts'> | CollectionEntry<'dialogues'>
}

const { entry } = Astro.props
const { title, description, pubDate, updatedDate, tags, model } = entry.data
const isDialogue = entry.collection === 'dialogues'
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="mb-8">
      {
        isDialogue && (
          <p class="mb-2 text-sm text-sky-600 dark:text-sky-400">
            AI 问答{model && ` · ${model}`}
          </p>
        )
      }
      <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-neutral-500 dark:text-neutral-400">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <span>
              更新于 <FormattedDate date={updatedDate} />
            </span>
          )
        }
        <TagList tags={tags} />
      </div>
    </header>

    <div class="prose prose-neutral dark:prose-invert max-w-none">
      <slot />
    </div>
  </article>

  <Giscus />
</BaseLayout>
