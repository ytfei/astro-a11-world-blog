---
import { getCollection } from 'astro:content'
import { COLLECTION_LABELS } from '../../consts'
import BaseLayout from '../../layouts/BaseLayout.astro'
import FormattedDate from '../../components/FormattedDate.astro'

export async function getStaticPaths() {
  const published = (
    await Promise.all([getCollection('posts'), getCollection('dialogues'), getCollection('wechat')])
  )
    .flat()
    .filter((e) => !e.data.draft)

  const tagMap = new Map<string, typeof published>()
  for (const entry of published) {
    for (const tag of entry.data.tags) {
      if (!tagMap.has(tag)) tagMap.set(tag, [])
      tagMap.get(tag)!.push(entry)
    }
  }
  return [...tagMap.entries()].map(([tag, entries]) => ({
    params: { tag },
    props: {
      entries: entries.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }))
}

const { tag } = Astro.params
const { entries } = Astro.props
---

<BaseLayout title={`#${tag}`}>
  <h1 class="mb-8 text-3xl font-bold tracking-tight">#{tag}</h1>
  <ul class="space-y-6">
    {
      entries.map((entry) => (
        <li>
          <h2 class="text-lg font-semibold">
            <a href={`/${entry.collection}/${entry.id}/`} class="hover:underline">
              {entry.data.title}
            </a>
          </h2>
          <p class="mt-1 flex items-center gap-3 text-sm text-neutral-500 dark:text-neutral-400">
            <FormattedDate date={entry.data.pubDate} />
            <span class="rounded bg-neutral-200 px-2 py-0.5 text-xs dark:bg-neutral-800">
              {COLLECTION_LABELS[entry.collection] ?? entry.collection}
            </span>
          </p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
