---
import { SITE_TITLE } from '../consts'

const navItems = [
  { href: '/', label: '首页' },
  { href: '/posts/', label: '文章' },
  { href: '/dialogues/', label: '问答' },
  { href: '/wechat/', label: '公众号' },
  { href: '/reports/', label: '报告' },
  { href: '/tags/', label: '标签' },
  { href: '/about/', label: '关于' },
]

const currentPath = Astro.url.pathname
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href)
---

<header class="border-b border-neutral-200 dark:border-neutral-800">
  <div class="mx-auto max-w-3xl px-4 py-4">
    <div class="flex items-center justify-between">
      <a href="/" class="text-lg font-bold">{SITE_TITLE}</a>
      <button
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="切换导航菜单"
        class="rounded p-2 transition-colors hover:bg-neutral-200 md:hidden dark:hover:bg-neutral-800"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path class="icon-open" d="M4 6h16M4 12h16M4 18h16"></path>
          <path class="icon-close hidden" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <nav
      id="site-nav"
      aria-label="主导航"
      class="hidden md:mt-0 md:block"
    >
      <ul
        class="flex flex-col items-start gap-1 pt-4 text-sm md:flex-row md:justify-end md:pt-0"
      >
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'inline-block rounded px-3 py-1.5 transition-colors hover:bg-neutral-200 dark:hover:bg-neutral-800',
                  isActive(item.href) && 'font-semibold',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle')
  const nav = document.getElementById('site-nav')

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true'
    toggle.setAttribute('aria-expanded', String(!expanded))
    nav?.classList.toggle('hidden', expanded)
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', !expanded)
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', expanded)
  })
</script>
