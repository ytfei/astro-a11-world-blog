---
import { SITE_TITLE, SITE_SLOGAN } from "../consts";
const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-200 py-6 dark:border-neutral-800">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-2 px-4 text-sm text-neutral-500 dark:text-neutral-400">
        <p>
            © {year} {SITE_TITLE}
        </p>
        <p class="text-neutral-400 dark:text-neutral-500">{SITE_SLOGAN}</p>
        <p>
            <a
                href="https://beian.miit.gov.cn/"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-neutral-800 dark:hover:text-neutral-200"
            >
                浙ICP备2025214128号-4
            </a>
        </p>
    </div>
</footer>
